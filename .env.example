# Copia este fichero a .env.local y rellénalo. .env.local nunca se commitea.

# ---- Supabase: público, viaja al navegador ----
# Sin estas dos, la aplicación arranca pero no puede autenticar a nadie.
# Se usa la clave publicable moderna (sb_publishable_...) y no la anon legada,
# porque se puede rotar sin tocar el resto de claves del proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Supabase: solo servidor ----
# Salta RLS por completo. Si esta clave llega al navegador, cualquiera puede
# leer el dinero de todos los hogares. No la uses en componentes de cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role
